    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "flutter_app",
            "cwd": "flutter_app",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define-from-file=secrets.json"]
        },
        {
            "name": "flutter_app (profile mode)",
            "cwd": "flutter_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": ["--dart-define-from-file=secrets.json"]
        },
        {
            "name": "flutter_app (release mode)",
            "cwd": "flutter_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--dart-define-from-file=secrets.json"]
        }
    ]
}