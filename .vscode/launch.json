{
    // Config files in flutter_app/ (git-ignored; see secrets.example.json):
    //   secrets.dev.json  -> the CutTracker-dev AWS stack
    //   secrets.prod.json -> the CutTracker-prod AWS stack (real users' data)
    //
    // The prod API only accepts browser requests from https://tsrnb.github.io, so
    // run cuttracker-prod on a phone or emulator, and cuttracker-dev for Chrome.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cuttracker-dev",
            "cwd": "flutter_app",
            "request": "launch",
            "type": "dart",
            "args": ["--web-port=8080", "--dart-define-from-file=secrets.dev.json"]
        },
        {
            "name": "cuttracker-prod",
            "cwd": "flutter_app",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define-from-file=secrets.prod.json"]
        }
    ]
}
